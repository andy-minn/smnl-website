---
import CustomerTestimonials from "../components/sections/testimonials/CustomerTestimonials.astro";
import EnvironmentalImpact from "../components/sections/environment/EnvironmentalImpact.astro";
import FeaturedProjects from "../components/sections/featured/FeaturedProjects.astro";
import GetInvolved from "../components/sections/cta/GetInvolved.astro";
import Hero from "../components/sections/hero/Hero.astro";
import KeyServices from "../components/sections/services/KeyServices.astro";
import LatestInnovations from "../components/sections/innovations/LatestInnovations.astro";
import TrustRelationships from "../components/sections/trust/TrustRelationships.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Sinma Nayla | International Trading Across Asia"
  description="Sinma Nayla is a Singapore-based international trading company connecting trusted suppliers and customers across Asia through sourcing, product coordination and cross-border trade."
>
  <main class="flex flex-col gap-y-20 md:gap-y-40 overflow-hidden">
    <!-- Hero Section -->
    <Hero />

    <!-- What We Trade -->
    <KeyServices />

    <!-- Our Regional Reach -->
    <LatestInnovations />

    <!-- Singapore Trading Hub -->
    <EnvironmentalImpact />

    <!-- How We Work -->
    <FeaturedProjects />

    <!-- Built on Trust -->
    <TrustRelationships />

    <!-- Customer Testimonials — enable when actual testimonials are available -->
    <!-- <CustomerTestimonials /> -->

    <!-- Final CTA / Contact -->
    <GetInvolved />
  </main>
</Layout>
