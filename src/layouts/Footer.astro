---
import Container from "../components/shared/Container.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import smnlLogo from "../components/sections/hero/assets/smnl-logo-01.webp";

const footerCompany = [
  {
    itemText: "About Us",
    itemLink: "#about",
  },
  {
    itemText: "How We Work",
    itemLink: "#how-we-work",
  },
  {
    itemText: "Built on Trust",
    itemLink: "#trust",
  },
];

const footerBusiness = [
  {
    itemText: "What We Trade",
    itemLink: "#services",
  },
  {
    itemText: "Our Markets",
    itemLink: "#markets",
  },
  {
    itemText: "Trading Hub",
    itemLink: "#trading-hub",
  },
];
---

<div class="relative mt-16 bg-base-200 dark:bg-base-dark-800">
  <footer class="relative pt-20 rounded-t-3xl">
    <Container className="pb-10 relative">
      <div
        class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-12"
      >
        <!-- Brand / Company Introduction -->
        <div class="md:col-span-2 lg:col-span-1">
          <a
            href="/"
            class="relative inline-flex items-center"
            aria-label="SMNL - Home"
          >
            <img src={smnlLogo.src} alt="SMNL" class="h-12 w-auto" />
          </a>

          <Paragraph className="mt-8 max-w-xs">
            Connecting trusted suppliers and customers across Asia through
            international trade.
          </Paragraph>
        </div>

        <!-- Company -->
        <div>
          <h3 class="text-lg font-semibold text-heading-1">Company</h3>

          <ul class="mt-6 space-y-4">
            {
              footerCompany.map((item) => (
                <li>
                  <a
                    href={item.itemLink}
                    class="text-heading-3 transition hover:text-primary"
                  >
                    {item.itemText}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Our Business -->
        <div>
          <h3 class="text-lg font-semibold text-heading-1">Our Business</h3>

          <ul class="mt-6 space-y-4">
            {
              footerBusiness.map((item) => (
                <li>
                  <a
                    href={item.itemLink}
                    class="text-heading-3 transition hover:text-primary"
                  >
                    {item.itemText}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Follow Us -->
        <div>
          <h3 class="text-lg font-semibold text-heading-1">Follow Us</h3>

          <div class="mt-6 flex items-center gap-5 text-heading-3">
            <!-- Facebook -->
            <a
              href="#"
              aria-label="Facebook"
              class="transition hover:text-primary hover:scale-105"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="h-5 w-5"
                viewBox="0 0 16 16"
              >
                <path
                  d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"
                ></path>
              </svg>
              <span class="sr-only">Facebook</span>
            </a>

            <!-- LinkedIn -->
            <a
              href="#"
              aria-label="LinkedIn"
              class="transition hover:text-primary hover:scale-105"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="h-5 w-5"
                viewBox="0 0 16 16"
              >
                <path
                  d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
                ></path>
              </svg>
              <span class="sr-only">LinkedIn</span>
            </a>

            <!-- X / Twitter
            <a
              href="#"
              aria-label="X / Twitter"
              class="transition hover:text-primary hover:scale-105"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="h-5 w-5"
                viewBox="0 0 16 16"
              >
                <path
                  d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
                />
              </svg>
              <span class="sr-only">X / Twitter</span>
            </a> -->

            <!-- X
            <a
              href="#"
              aria-label="X"
              class="transition hover:text-primary hover:scale-105"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="currentColor"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817-5.963 6.817H1.684l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
                ></path>
              </svg>
              <span class="sr-only">X</span>
            </a> -->

            <!-- Google Maps -->
            <a
              href="https://www.google.com/maps/search/?api=1&query=27+Penjuru+Lane+Singapore+609195"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Google Maps"
              class="transition hover:text-primary hover:scale-105"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                fill="currentColor"
                viewBox="0 0 24 24"
                class="h-5 w-5"
              >
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"
                ></path>
              </svg>
              <span class="sr-only">Google Maps</span>
            </a>
          </div>
        </div>
      </div>
    </Container>

    <!-- Copyright -->
    <div
      class="relative border-t border-border-light dark:border-base-dark-700"
    >
      <Container>
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-4 py-5 text-sm text-heading-3"
        >
          <div class="text-center md:text-left">
            &copy; <span id="year">{new Date().getFullYear()}</span> Sinma Nayla Pte
            Ltd. All rights reserved.
          </div>
        </div>
      </Container>
    </div>
  </footer>
</div>
