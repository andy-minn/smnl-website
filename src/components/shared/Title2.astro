---
export interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<div class="mb-8 w-fit">
  <h2
    class={`text-xl font-bold uppercase tracking-wide text-primary ${className}`}
  >
    <slot />
  </h2>

  <div class="mx-auto mt-2 h-0.5 w-[50%] rounded-full bg-primary"></div>
</div>