---
import Container from "../../shared/Container.astro";
import GradiantText from "../../shared/GradiantText.astro";
import SubTitle2 from "../../shared/SubTitle2.astro";
import Title2 from "../../shared/Title2.astro";
import FeaturedProject from "../featured/components/FeaturedProject.astro";
import { trustSection } from "./data.ts";

export interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<section id="trust" class=`scroll-mt-24 ${className}`>
  <Container
    className="mx-auto flex flex-col items-center justify-center text-center"
  >
    <Title2>{trustSection.title}</Title2>

    <SubTitle2>
      {trustSection.subheading1_1}
      <GradiantText>{trustSection.subheading1_2}</GradiantText>
    </SubTitle2>
  </Container>

  <Container>
    <div class="mt-8 grid sm:grid-cols-3 lg:grid-cols-3 gap-6 lg:gap-8">
      {
        trustSection.cards.map((card) => {
          return (
            <FeaturedProject
              number={card.number}
              title={card.title}
              description={card.description}
            />
          );
        })
      }
    </div>
  </Container>
</section>
