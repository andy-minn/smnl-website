---
import Title3 from "../../../shared/Title3.astro";
import LazyImage from "../../../shared/LazyImage.astro";

export interface Props {
  title: string;
  description: string;
  visual: ImageMetadata;
  imageAlt: string;
}

const { title, description, visual, imageAlt } = Astro.props;
const animation = `duration-300 ease-linear`;
---

<div
  class={`
    ${animation} group
    relative h-full overflow-hidden rounded-lg
  `}
>
  <LazyImage
    src={visual}
    alt={imageAlt}
    height="400"
    class={`
      h-96 w-full object-cover
      ${animation} group-hover:scale-125
    `}
  />

  <div
    class={`
      absolute top-0 h-full w-full
      bg-gradient-to-b from-black/10 to-black/30
      ${animation} group-hover:bg-black/30
    `}
  >
  </div>

  <!-- content-center tested and removed; no visual effect in this layout -->
  <div
    class={`
      absolute bottom-0 flex w-full flex-col
      translate-y-[calc(100%-7.5rem)] group-hover:translate-y-0
      ${animation}
    `}
  >
    <div class={`m-6 text-white ${animation}`}>
      <Title3 className="mb-0">
        {title}
      </Title3>
    </div>

    <div
      class={`
        m-6 self-baseline opacity-0
        group-hover:opacity-100 ${animation}
      `}
    >
      <div class="text-base text-white">
        {description}
      </div>
    </div>
  </div>
</div>
