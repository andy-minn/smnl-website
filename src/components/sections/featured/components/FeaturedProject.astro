---
import Paragraph from "../../../shared/Paragraph.astro";
import { Image } from "astro:assets";
import Title2 from "../../../shared/Title2.astro";
import Button from "../../../shared/Button.astro";
import Title3 from "../../../shared/Title3.astro";
import LazyImage from "../../../shared/LazyImage.astro";

export interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<div class="group h-full flex flex-col rounded-lg bg-white dark:bg-base-dark-800 p-6 md:p-8 shadow-lg dark:shadow-dark ring-1 ring-black/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl" >
  <div class="mb-8 text-4xl md:text-5xl font-bold text-primary-400/80 dark:text-primary-300/70" >
    {number}
  </div>

  <div class="flex flex-col gap-4">
    <Title3 className="dark:opacity-70">
      {title}
    </Title3>

    <div class="text-sm leading-relaxed text-[#647789]">
      {description}
    </div>
  </div>
</div>
